{
  "name": "BOMChangeLog",
  "type": "object",
  "properties": {
    "bom_id": {
      "type": "string",
      "description": "FK \u2192 BOM"
    },
    "change_type": {
      "type": "string",
      "description": "status_transition | line_added | line_removed | line_modified | variant_modified | derived | derived_source_changed | routing_synced | routing_overridden | matrix_axis_changed | uom_overridden"
    },
    "payload": {
      "type": "object",
      "description": "Before/after diff JSON"
    },
    "triggered_by": {
      "type": "string",
      "description": "User email"
    },
    "triggered_at": {
      "type": "string",
      "description": "ISO datetime"
    }
  },
  "required": [
    "bom_id",
    "change_type"
  ]
}