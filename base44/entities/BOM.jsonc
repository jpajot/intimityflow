{
  "name": "BOM",
  "type": "object",
  "properties": {
    "bom_type": {
      "type": "string",
      "description": "LOV: bom_type (development, production)"
    },
    "product_id": {
      "type": "string",
      "description": "FK \u2192 Product"
    },
    "revision_code": {
      "type": "string",
      "description": "e.g. A, B, C"
    },
    "version": {
      "type": "number",
      "description": "Pre-release iteration counter",
      "default": 1
    },
    "status": {
      "type": "string",
      "description": "LOV: bom_status (draft, in_review, released, superseded, obsolete)",
      "default": "draft"
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "description": "Start of validity window. Null = effective immediately upon release."
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "End of validity window. Null = no end date / effective indefinitely."
    },
    "released_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "released_by": {
      "type": "string",
      "description": "User email"
    },
    "superseded_by_id": {
      "type": "string",
      "description": "FK \u2192 BOM (self-ref) \u2014 revision-level supersession at release time"
    },
    "superseded_by_version_id": {
      "type": "string",
      "description": "FK \u2192 BOM (self-ref, nullable) \u2014 version-level supersession within the same revision. Set when a newer version of the same revision is created."
    },
    "derived_from_bom_id": {
      "type": "string",
      "description": "FK \u2192 BOM (dev BOM this was derived from)"
    },
    "derived_from_revision_code": {
      "type": "string",
      "description": "Snapshot of source revision at derivation time"
    },
    "order_context": {
      "type": "object",
      "description": "JSON: factory_supplier_id, region, season_variant, customer_ref, target_quantity"
    },
    "selected_routing_id": {
      "type": "string",
      "description": "FK \u2192 SupplierRouting (production BOMs only)"
    },
    "notes": {
      "type": "string"
    },
    "pending_eco_review_count": {
      "type": "number",
      "default": 0,
      "description": "Derived count of ECOAffectedDownstream rows targeting this BOM where propagation_status is in a non-terminal state (pending, notified, under_review). Maintained by the ECO propagation layer. Source of truth is ECOAffectedDownstream itself; this integer is a denormalized cache for fast badge rendering. Reconcileable via the recountBomPendingEcoReviews function."
    }
  },
  "required": [
    "bom_type",
    "product_id"
  ]
}