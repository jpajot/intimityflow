{
  "name": "Sample",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "FK \u2192 Project. Every sample is project-scoped."
    },
    "supplier_request_id": {
      "type": "string",
      "description": "FK \u2192 SupplierRequest. Optional \u2014 samples can exist standalone and be attached to a Supplier Request later, or never."
    },
    "code": {
      "type": "string",
      "description": "Auto-generated hash-style code (e.g. SMP-A7B3F2). Generated by SystemCodeGenerator on creation when blank."
    },
    "qr_code_data": {
      "type": "string",
      "description": "Populated at creation time. Stores the same value as code by default \u2014 the QR encoding is then equivalent to the code lookup. A future iteration may store a URL instead."
    },
    "product_id": {
      "type": "string",
      "description": "FK \u2192 Product. The product being sampled."
    },
    "product_color_id": {
      "type": "string",
      "description": "FK \u2192 ProductColor. Colorway of the sample."
    },
    "product_color_and_more_id": {
      "type": "string",
      "description": "FK \u2192 ProductColorAndMore. PCAM-level granularity."
    },
    "size_id": {
      "type": "string",
      "description": "FK \u2192 Size. Specific size being sampled."
    },
    "sample_type": {
      "type": "string",
      "enum": [
        "volume",
        "proto",
        "sample",
        "sms",
        "test_au_porter",
        "gold_seal",
        "pps"
      ],
      "description": "Sample type. Drives the derived phase attribute. Volume=Development, Proto=Development, Sample=Development, SMS=Development, Test Au Porter=Development, Gold Seal=Production, PPS=Production."
    },
    "phase": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ],
      "description": "Derived from sample_type at creation time and on any sample_type change. Drives default routing selection. development for sample_type in (volume, proto, sample, sms, test_au_porter); production for sample_type in (gold_seal, pps)."
    },
    "requested_quantity": {
      "type": "number",
      "description": "How many physical units are requested for this sample. Inherited by each SampleStep at routing generation, editable per step thereafter."
    },
    "linked_routing_id": {
      "type": "string",
      "description": "FK \u2192 SupplierRouting. Populated when the user generates the sample routing (cloning a reference routing as routing_type='sample'). Null when no sample routing exists yet."
    },
    "conformity_status": {
      "type": "string",
      "enum": [
        "not_assessed",
        "pass",
        "fail_minor",
        "fail_major",
        "pending_review"
      ],
      "default": "not_assessed",
      "description": "Sample-level conformity assessment. Independent of step-level conformity but typically reflects the worst step outcome. Editable directly by the user; may be set as a roll-up of step conformity in UI helpers but the field itself is not auto-computed."
    },
    "notes": {
      "type": "string",
      "description": "Optional free-text notes."
    }
  },
  "required": [
    "project_id",
    "code",
    "product_id",
    "sample_type",
    "phase",
    "conformity_status"
  ]
}