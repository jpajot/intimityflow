{
  "name": "ProductColor",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "color_name": {
      "type": "string"
    },
    "colorway_code": {
      "type": "string",
      "description": "Colorway code"
    },
    "color_hex": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "linked_tech_color_id": {
      "type": "string",
      "description": "ID of the linked TechnicalColor"
    },
    "linked_color_type": {
      "type": "string",
      "enum": [
        "commercial"
      ],
      "description": "Type of library color linked (commercial only)"
    },
    "linked_color_id": {
      "type": "string",
      "description": "ID of the linked CommercialColor"
    },
    "creation_project_id": {
      "type": "string",
      "description": "ID of the Project where this colorway was created"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of Projects this colorway is linked to"
    },
    "colorway_status": {
      "type": "string",
      "description": "LOV: productcolor_status \u2014 requested, in_progress, submitted_for_approval, approved, rejected, obsolete",
      "default": "approved"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Append-only audit trail: [{status, changed_at, changed_by, notes}]"
    },
    "requested_by": {
      "type": "string",
      "description": "User email \u2014 set on creation when created from a BOM"
    },
    "requested_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "approved_by": {
      "type": "string",
      "description": "User email \u2014 set when status reaches approved"
    },
    "approved_at": {
      "type": "string",
      "description": "ISO datetime"
    }
  },
  "required": [
    "product_id",
    "color_name"
  ]
}