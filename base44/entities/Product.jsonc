{
  "name": "Product",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Product code (e.g. STY00001)"
    },
    "type": {
      "type": "string",
      "description": "Product type (Product or Material) - linked to Product Type LOV"
    },
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "sub_type": {
      "type": "string",
      "description": "Product sub-type - linked to Sub-Types LOV"
    },
    "category": {
      "type": "string",
      "description": "Product category"
    },
    "sub_category": {
      "type": "string",
      "description": "Product sub-category"
    },
    "customer_need": {
      "type": "string",
      "description": "Target customer need"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Style images (first image is the main/cover image)"
    },
    "size_grid_id": {
      "type": "string",
      "description": "Linked SizeGrid ID"
    },
    "creation_project_id": {
      "type": "string",
      "description": "ID of the Project where this style was created"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of Projects this style is linked to"
    },
    "default_uom": {
      "type": "string",
      "description": "Default unit of measure for consumption \u2014 LOV: uom (e.g. m, pcs, kg)"
    },
    "default_uom_for_purchasing": {
      "type": "string",
      "description": "Optional: UOM used when purchasing (e.g. roll). LOV: uom. Null = same as default_uom."
    },
    "uom_conversion_factor": {
      "type": "number",
      "description": "How many consumption units = 1 purchasing unit (e.g. 50 m per roll \u2192 50). Required when default_uom_for_purchasing differs from default_uom."
    },
    "bom_workflow_pattern": {
      "type": "string",
      "description": "LOV: bom_workflow_pattern \u2014 dev_then_prod, direct_prod. Defaults to dev_then_prod.",
      "default": "dev_then_prod"
    }
  },
  "required": [
    "type",
    "name",
    "category",
    "sub_category",
    "customer_need"
  ]
}