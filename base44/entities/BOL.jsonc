{
  "name": "BOL",
  "type": "object",
  "properties": {
    "bom_id": {
      "type": "string",
      "description": "FK \u2192 BOM (one BOL per Production BOM)"
    },
    "source_routing_id": {
      "type": "string",
      "description": "FK \u2192 SupplierRouting"
    },
    "source_routing_snapshot_at": {
      "type": "string",
      "description": "ISO datetime of last sync"
    },
    "notes": {
      "type": "string"
    },
    "pending_eco_review_count": {
      "type": "number",
      "default": 0,
      "description": "Derived count of ECOAffectedDownstream rows targeting this BOL where propagation_status is in a non-terminal state (pending, notified, under_review). Maintained by the ECO propagation layer. Source of truth is ECOAffectedDownstream itself; this integer is a denormalized cache for fast badge rendering. Reconcileable via the recountBolPendingEcoReviews function."
    }
  },
  "required": [
    "bom_id"
  ]
}