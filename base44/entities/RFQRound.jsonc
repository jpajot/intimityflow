{
  "name": "RFQRound",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short code, e.g. R1, R2, RF. Must be unique."
    },
    "label": {
      "type": "string",
      "description": "Display name, e.g. Round 1, Final Round"
    },
    "sequence": {
      "type": "number",
      "description": "Display order in dropdowns (1, 2, 3...)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive rounds are hidden from selectors"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    }
  },
  "required": [
    "code",
    "label",
    "sequence"
  ]
}