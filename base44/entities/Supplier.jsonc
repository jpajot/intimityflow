{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Auto-generated code e.g. SUP00001"
    },
    "name": {
      "type": "string",
      "description": "Supplier trading name"
    },
    "legal_name": {
      "type": "string",
      "description": "Legal registered name"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "description": "LOV: supplier_region"
    },
    "city": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LOV: supplier_capability"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LOV: supplier_certification"
    },
    "lead_time_default_days": {
      "type": "number"
    },
    "moq_policy": {
      "type": "string"
    },
    "payment_terms_default": {
      "type": "string",
      "description": "LOV: payment_terms"
    },
    "currency_default_id": {
      "type": "string",
      "description": "FK \u2192 Currency. Default invoicing/quoting currency for this supplier."
    },
    "status": {
      "type": "string",
      "description": "LOV: supplier_status",
      "default": "active"
    },
    "status_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "portal_access_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, this supplier is allowed to have portal users. When false, portal sign-in is rejected for any user linked to this supplier."
    },
    "portal_notes": {
      "type": "string",
      "description": "Internal notes about portal access (e.g. 'primary contact prefers email, set up portal for backup')."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "supplier"
              }
            },
            {
              "id": "{{user.data.linked_supplier_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}