{
  "name": "BoardPage",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "description": "Linked Board ID"
    },
    "page_number": {
      "type": "number",
      "description": "Page order index (1-based)"
    },
    "name": {
      "type": "string",
      "description": "Page name e.g. Slide 1"
    },
    "elements": {
      "type": "array",
      "description": "Array of canvas element objects",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "board_id",
    "page_number"
  ]
}