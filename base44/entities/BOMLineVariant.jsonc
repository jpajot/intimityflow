{
  "name": "BOMLineVariant",
  "type": "object",
  "properties": {
    "bom_line_id": {
      "type": "string",
      "description": "FK \u2192 BOMLine"
    },
    "product_color_id": {
      "type": "string",
      "description": "FK \u2192 ProductColor (parent product's colorway)"
    },
    "component_product_color_id": {
      "type": "string",
      "description": "FK \u2192 ProductColor (component's colorway for this parent colorway)"
    },
    "size_id": {
      "type": "string",
      "description": "FK \u2192 Size"
    },
    "component_size_id": {
      "type": "string",
      "description": "FK \u2192 Size (the component's size mapped to this parent variant)"
    },
    "product_color_and_more_id": {
      "type": "string",
      "description": "FK \u2192 ProductColorAndMore (parent product's ColorAndMore variation)"
    },
    "component_color_and_more_id": {
      "type": "string",
      "description": "FK \u2192 ProductColorAndMore (component's ColorAndMore \u2014 nullable)"
    },
    "parent_approved_supplier_id": {
      "type": "string",
      "description": "FK \u2192 ApprovedSupplier (the parent product's vendor scenario this variant applies to \u2014 the column dimension in the Supplier matrix. Null when the line does not vary by parent vendor.)"
    },
    "approved_supplier_id": {
      "type": "string",
      "description": "FK \u2192 ApprovedSupplier \u2014 the component's supplier picked for this variant intersection"
    },
    "product_color_supplier_link_id": {
      "type": "string",
      "description": "FK \u2192 ProductColorSupplierLink (replaces color_override_id)"
    },
    "quantity": {
      "type": "number",
      "description": "Override quantity \u2014 null = inherit from BOMLine.base_quantity"
    },
    "unit_cost_override": {
      "type": "number"
    },
    "currency_override": {
      "type": "string",
      "description": "LOV: currency"
    },
    "lead_time_override_days": {
      "type": "number"
    },
    "wastage_pct": {
      "type": "number",
      "description": "Production BOMs, default 0",
      "default": 0
    },
    "is_not_applicable": {
      "type": "boolean",
      "description": "When true, this cell intersection is explicitly marked NA \u2014 the BOMLine does not consume any component for this parent variant",
      "default": false
    },
    "na_reason": {
      "type": "string",
      "description": "Optional reason text when is_not_applicable = true"
    },
    "notes": {
      "type": "string"
    },
    "component_revision_snapshots": {
      "type": "object",
      "description": "Snapshot of ProductRevision ids for each revisable component entity referenced by this variant at authoring time. Keys correspond to BOMLineVariant FK fields; values are ProductRevision ids. Used by Flow D ECO triggers to detect when a referenced entity has been revised since this variant was authored. Expected keys (all optional): component_product_color_id, component_color_and_more_id, component_size_id. Each key holds the ProductRevision.id where is_current=true for that referenced entity at authoring time. Null until populated by authoring-time logic in a later phase. Missing key = FK was null at authoring time OR no ProductRevision existed yet (legacy variant)."
    }
  },
  "required": [
    "bom_line_id"
  ]
}