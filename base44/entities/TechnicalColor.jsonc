{
  "name": "TechnicalColor",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Technical color code e.g. 11-0601 TCX"
    },
    "name": {
      "type": "string",
      "description": "Color name e.g. Bright White"
    },
    "hex": {
      "type": "string",
      "description": "HEX color value e.g. #F4F5F0"
    },
    "rgb": {
      "type": "string",
      "description": "RGB values as comma-separated string e.g. 244,245,240"
    },
    "cmyk": {
      "type": "string",
      "description": "CMYK values as comma-separated string e.g. 0,1,3,4"
    },
    "color_group": {
      "type": "string",
      "description": "Color group (LOV: ColorGroup)"
    },
    "color_sub_group": {
      "type": "string",
      "description": "Color sub-group (LOV: ColorSubGroup, depends on color_group)"
    }
  },
  "required": [
    "code",
    "name"
  ]
}