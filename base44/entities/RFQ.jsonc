{
  "name": "RFQ",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Auto-generated RFQ code (e.g. RFQ00001). Generated by SystemCodeGenerator on creation when blank."
    },
    "name": {
      "type": "string",
      "description": "Human-readable RFQ name (e.g. SS26 R1 Costing)."
    },
    "project_id": {
      "type": "string",
      "description": "FK \u2192 Project. The project this RFQ is scoped to."
    },
    "round_id": {
      "type": "string",
      "description": "FK \u2192 RFQRound. Which round this RFQ belongs to (R1, R2, RF, etc.)."
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Date by which suppliers should respond. UI defaults to today + AppConfig.rfq_default_due_days."
    },
    "target_currency_id": {
      "type": "string",
      "description": "FK \u2192 Currency. Currency every quote will be converted to for reporting. Defaults from AppConfig.target_currency_id."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "in_collection",
        "closed",
        "archived"
      ],
      "default": "draft",
      "description": "Lifecycle status of the RFQ."
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO datetime when status moved to submitted."
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of user who submitted."
    },
    "closed_at": {
      "type": "string",
      "description": "ISO datetime when status moved to closed."
    },
    "closed_by": {
      "type": "string",
      "description": "Email of user who closed."
    },
    "sample_requests": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Reserved for the future Sample Request sub-section. Empty array by default."
    },
    "shared_product_specs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Reserved for the future Shared Product Specs sub-section. Empty array by default."
    },
    "description": {
      "type": "string",
      "description": "Free-text purpose / instructions to suppliers."
    },
    "notes": {
      "type": "string",
      "description": "Internal notes, not visible to suppliers."
    }
  },
  "required": [
    "name",
    "project_id",
    "round_id",
    "target_currency_id",
    "status"
  ]
}