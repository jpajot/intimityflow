{
  "name": "BOLOperation",
  "type": "object",
  "properties": {
    "bol_id": {
      "type": "string",
      "description": "FK \u2192 BOL"
    },
    "source_routing_step_id": {
      "type": "string",
      "description": "FK \u2192 SupplierRoutingStep"
    },
    "sequence": {
      "type": "number"
    },
    "step_type": {
      "type": "string",
      "description": "LOV: routing_step_type"
    },
    "supplier_id": {
      "type": "string",
      "description": "FK \u2192 Supplier"
    },
    "description": {
      "type": "string"
    },
    "unit_cost_override": {
      "type": "number"
    },
    "currency_override": {
      "type": "string",
      "description": "LOV: currency"
    },
    "lead_time_override_days": {
      "type": "number"
    },
    "operation_status": {
      "type": "string",
      "description": "LOV: bol_operation_status (active, inherited, overridden, removed)",
      "default": "inherited"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
