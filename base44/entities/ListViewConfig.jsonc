{
  "name": "ListViewConfig",
  "type": "object",
  "properties": {
    "page_key": {
      "type": "string",
      "description": "Identifies which page/view this config belongs to (e.g. styles_list, gallery_styles_list)"
    },
    "name": {
      "type": "string",
      "description": "User-visible name for this view"
    },
    "column_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of column IDs to show"
    },
    "fixed_column_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Column IDs that are pinned/fixed to the left"
    },
    "filters_config": {
      "type": "object",
      "description": "Filter configuration: { operator: 'and'|'or', filters: [{field, values, operator}] }"
    },
    "thumb_size": {
      "type": "string",
      "enum": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "description": "Thumbnail size for gallery views"
    },
    "allowed_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Restrict to these roles. Empty = all roles."
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "When true, this view is a system-provided default that cannot be edited or deleted by users. Edit and trash buttons are hidden in the Manage Views dropdown for system views. New system views can only be added via seed scripts or admin tooling."
    },
    "display_mode": {
      "type": "string",
      "enum": [
        "list",
        "gallery"
      ],
      "description": "Explicit display mode this view applies to. Determines which mode toggle the view appears under in the Manage Views dropdown. Required on insert going forward; existing records will be backfilled from thumb_size presence."
    }
  },
  "required": [
    "page_key",
    "name"
  ]
}