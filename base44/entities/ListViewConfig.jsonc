{
  "name": "ListViewConfig",
  "type": "object",
  "properties": {
    "page_key": {
      "type": "string",
      "description": "Identifier for the page + type, e.g. 'styles' or 'materials'"
    },
    "name": {
      "type": "string",
      "description": "View name, e.g. 'Sales View'"
    },
    "column_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of visible column IDs"
    },
    "filters_config": {
      "type": "object",
      "description": "Filter configuration: { operator: 'and'|'or'|'nor', filters: [{field, values}] }"
    },
    "allowed_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user roles that can see this view. Empty = visible to all."
    }
  },
  "required": [
    "page_key",
    "name",
    "column_ids"
  ]
}